# Supabase - https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for seed script (Dashboard > Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Formspree contact form (already configured)
# FORMSPREE_ENDPOINT is hardcoded in contact page

# Google Places API (New) — server only. Do not use a NEXT_PUBLIC_ prefix.
# Rating and review count fall back to 5.0 / 36 until both values are set.
# GOOGLE_PLACE_ID is the ChIJ place id, not the Maps feature id or CID.
# How to find it: src/lib/google-place-summary.ts
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
